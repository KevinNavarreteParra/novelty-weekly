[Unit]
Description=Novelty Weekly: record recently played tracks

[Service]
Type=oneshot
# prun resolves the pass:// references in the repo's .env at launch. It calls
# pass-session and pass-cli by name, and systemd's PATH lacks ~/.local/bin.
WorkingDirectory=%h/utilities/recmus
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/prun %h/.cargo/bin/novelty poll
